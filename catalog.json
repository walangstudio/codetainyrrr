        "claude mcp remove mempalace -s user 2>/dev/null; claude mcp add mempalace -s user -- mempalace-mcp"
      ]
    },
    {
      "key": "ruflo",
      "category": "AI Orchestration",
      "default": false,
      "supported_clis": ["claude"],
      "description": "Ruflo — 100+ specialized agents, swarms, federated memory. For the full loop (MCP server + hooks), run `npx -y ruflo@latest init` inside the container in your workspace — note this writes .claude-flow/ and .claude/ files into CWD.",
      "dependencies": ["node"],
      "install": "marketplace:ruvnet/ruflo:ruflo-core:ruflo"
    }
  ]
}
