    {
      "key": "node",
      "category": "Languages",
      "default": true,
      "supported_clis": ["*"],
      "description": "Node.js LTS via NVM",
      "install": "nvm:lts"
    },
    {
      "key": "php",
      "category": "Languages",
      "default": false,
      "supported_clis": ["*"],
      "description": "PHP CLI + common extensions",
      "install": "apt:php-cli php-mbstring php-xml php-curl"
    },
    {
      "key": "python",
      "category": "Languages",
      "default": false,
      "supported_clis": ["*"],
