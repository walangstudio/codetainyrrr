      "install": "marketplace:mksglu/context-mode:context-mode"
    },
    {
      "key": "everything-claude-code",
      "category": "Claude Code Plugins",
      "default": false,
      "supported_clis": ["claude"],
      "description": "48 agents + 183 skills (large)",
      "install": "marketplace:affaan-m/everything-claude-code:ecc:ecc"
    },
    {
      "key": "karpathy-skills",
      "category": "Claude Code Plugins",
      "default": false,
      "supported_clis": ["claude"],
      "description": "Karpathy's 4 principles: think first, minimal code",
      "install": "marketplace:forrestchang/andrej-karpathy-skills:andrej-karpathy-skills:karpathy-skills"
    },
    {
      "key": "gitnexus",
      "category": "AI Memory & Knowledge",
      "default": false,
      "supported_clis": ["*"],
      "description": "Code intelligence / knowledge graph engine (MCP server auto-wired)",
      "dependencies": ["node"],
      "install": "npm:gitnexus",
      "post_install": [
        "claude mcp remove gitnexus -s user 2>/dev/null; claude mcp add gitnexus -s user -- gitnexus mcp"
      ]
    },
    {
      "key": "graphify",
      "category": "AI Memory & Knowledge",
      "default": false,
      "supported_clis": ["*"],
      "description": "Codebase knowledge graph (safishamsi/graphify; PyPI: graphifyy)",
      "dependencies": ["uv"],
      "install": "uv:graphifyy",
      "post_install": [
        "claude mcp remove graphify -s user 2>/dev/null; claude mcp add graphify -s user -- graphify --mcp"
      ]
    },
    {
      "key": "mempalace",
      "category": "AI Memory & Knowledge",
      "default": false,
      "supported_clis": ["*"],
      "description": "Spatial AI memory indexed locally",
      "dependencies": ["uv"],
