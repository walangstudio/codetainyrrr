# codetainyrrr — copy to .env and customize
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Container user UID/GID
#
# Linux:          run `id -u` and `id -g` — usually 1000:1000
# macOS:          run `id -u` and `id -g` — usually 501:20
# Windows (WSL2): run `id -u` and `id -g` inside WSL — usually 1000:1000
# Windows (native Docker Desktop): leave as 1000:1000
#
# Getting this wrong won't break things but you may see permission errors
# when Claude tries to write files in your project directory.
# ---------------------------------------------------------------------------
HOST_UID=1000
HOST_GID=1000

# ---------------------------------------------------------------------------
# AI coding CLI to run by default.
# Options: claude | codex | gemini | opencode | pi | goose | aider | kilo | cn
# Override per-session:  ./run.sh --cli aider   (or .\run.ps1 -Cli aider)
# Change permanently:    ./run.sh switch aider  (or .\run.ps1 switch aider)
# ---------------------------------------------------------------------------
CODING_CLI=claude

# Wire ccstatusline status bar into Claude Code settings.json (true/false).
# Only applies when CODING_CLI=claude. Set false to skip.
WIRE_CCSTATUSLINE=true

# ---------------------------------------------------------------------------
# Container name — shown in `docker ps`. Change to run multiple instances.
# ---------------------------------------------------------------------------
CONTAINER_NAME=codetainyrrr

# ---------------------------------------------------------------------------
# Project directory — mounted at /workspace inside the container.
# Use absolute paths. The ~ shorthand works in run.sh / run.ps1 but NOT
# if you run docker compose directly.
#
# Linux / macOS:         PROJECT_DIR=/home/yourname/projects/myapp
# Windows (Git Bash):    PROJECT_DIR=/c/Users/yourname/projects/myapp
# Windows (PowerShell):  PROJECT_DIR=C:/Users/yourname/projects/myapp
# ---------------------------------------------------------------------------
PROJECT_DIR=/absolute/path/to/your/project

# ---------------------------------------------------------------------------
# Claude config — memories, settings, auth tokens, MCP registrations.
#
# Leave blank (default): uses a named Docker volume — isolated from your host,
#   persists across container runs. Good if you don't use Claude Desktop.
#
# Set to a path: bind-mounts from your host — container and Claude Desktop
#   share the same memories and MCP servers.
#
# Linux:              CLAUDE_DIR=/home/yourname/.claude
# macOS:              CLAUDE_DIR=/Users/yourname/.claude
# Windows (Git Bash): CLAUDE_DIR=/c/Users/yourname/.claude
# Windows (PS):       CLAUDE_DIR=C:/Users/yourname/.claude
# ---------------------------------------------------------------------------
CLAUDE_DIR=
CLAUDE_JSON=

# ---------------------------------------------------------------------------
# API keys — set whichever your chosen CLI needs.
# claude:   ANTHROPIC_API_KEY  (or leave blank for browser OAuth)
# codex:    OPENAI_API_KEY
# gemini:   GEMINI_API_KEY     (or leave blank for browser OAuth)
# aider:    OPENAI_API_KEY or ANTHROPIC_API_KEY
# pi:       ANTHROPIC_API_KEY
# opencode/goose/kilo/cn: set the key for whichever model provider you use
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Dev tools — installed at container start, persist in named volumes.
# Comma-separated list of: java, go, rust, ts, react, svelte, python,
#                           deno, bun, dotnet, lazygit
#
# cpp, php, ruby require baking into the image at build time — add them
# here and run ./run.sh --build (or .\run.ps1 -Build) once.
#
# Examples:
#   INSTALL_TOOLS=go,rust
#   INSTALL_TOOLS=java,ts,react
#   INSTALL_TOOLS=cpp,python      ← rebuild required for cpp
# ---------------------------------------------------------------------------
INSTALL_TOOLS=

# ---------------------------------------------------------------------------
# Plugins — installed at container start.
# Comma-separated list of built-in names or custom entries.
#
# Built-in:
#   ccusage, graphify, mempalace          (all CLIs)
#   caveman, context-mode, claude-mem,
#   claude-hud, everything-claude-code,
#   karpathy-skills                       (Claude only)
#
# Custom:
#   owner/repo       → Claude plugin from GitHub
#   npm:package      → npm install -g
#   uv:package       → uv tool install
#
# Add/remove at runtime: ./run.sh plugins add ccusage
# ---------------------------------------------------------------------------
INSTALL_PLUGINS=

# ---------------------------------------------------------------------------
# Bring-your-own configs (optional — leave blank to use built-in defaults).
# Each path is bind-mounted read-only into the container.
#
# CCSTATUSLINE_CONFIG  — ccstatusline settings.json
# ZSH_EXTRA_CONFIG     — sourced at end of .zshrc (aliases, env vars, etc.)
# STARSHIP_CONFIG      — starship.toml prompt config
# ---------------------------------------------------------------------------
CCSTATUSLINE_CONFIG=
ZSH_EXTRA_CONFIG=
STARSHIP_CONFIG=

# ---------------------------------------------------------------------------
# Extra workspaces — additional project directories to mount.
# Semicolon-separated list of absolute paths. Each mounts at /workspaces/<dirname>.
# Use ; not : — Windows drive letters (C:/) would break colon splitting.
#
# Linux / macOS:
#   EXTRA_WORKSPACES=/home/you/projects/api;/home/you/projects/frontend
# Windows (Git Bash):
#   EXTRA_WORKSPACES=/c/Users/you/projects/api;/c/Users/you/projects/frontend
# Windows (PowerShell):
#   EXTRA_WORKSPACES=C:/Users/you/projects/api;C:/Users/you/projects/frontend
# ---------------------------------------------------------------------------
EXTRA_WORKSPACES=

# ---------------------------------------------------------------------------
# Git identity — commits made inside the container will use these.
# ---------------------------------------------------------------------------
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com
