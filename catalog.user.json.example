{
  "_comment": "Copy this file to catalog.user.json to add your own tools and plugins.",
  "_comment2": "catalog.user.json is gitignored and auto-mounted into the container by run.sh/run.ps1.",
  "_comment3": "Entries with the same key as a built-in override the built-in entry.",

  "tools": [
    {
      "key": "my-tool",
      "category": "Custom",
      "default": false,
      "supported_clis": ["*"],
      "description": "My custom tool (raw shell install)",
      "install": "curl -fsSL https://example.com/install.sh | bash"
    },
    {
      "key": "my-npm-tool",
      "category": "Custom",
      "default": false,
      "supported_clis": ["*"],
      "description": "A tool from npm",
      "install": "npm:some-npm-package"
    },
    {
      "key": "my-python-tool",
      "category": "Custom",
      "default": false,
      "supported_clis": ["*"],
      "description": "A tool from PyPI via uv",
      "install": "uv:some-pypi-package"
    },
    {
      "key": "my-git-tool",
      "category": "Custom",
      "default": false,
      "supported_clis": ["*"],
      "description": "A tool from a GitHub repo (cloned, then install.sh run)",
      "install": "gh:owner/repo-name"
    },
    {
      "key": "my-git-url-tool",
      "category": "Custom",
      "default": false,
      "supported_clis": ["*"],
      "description": "A tool from any git URL",
      "install": "git:https://gitlab.com/owner/repo.git"
    }
  ],

  "plugins": [
    {
      "key": "my-claude-plugin",
      "category": "Custom",
      "default": false,
      "supported_clis": ["claude"],
      "description": "My custom Claude plugin from GitHub marketplace",
      "install": "gh:owner/my-claude-plugin"
    },
    {
      "key": "my-shared-plugin",
      "category": "Custom",
      "default": false,
      "supported_clis": ["*"],
      "description": "Works with any AI CLI",
      "install": "npm:some-ai-plugin"
    }
  ]
}
