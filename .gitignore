# Secrets — actual environment, never the template
.env
.env*
!env.example

# User-local catalog additions — gitignored, mount into container via run.sh/run.ps1
catalog.user.json

# Default project mount (your code lives here, not the container's)
workspace/

# OS detritus
.DS_Store
Thumbs.db
desktop.ini

# Editor swap / backup files
*.swp
*.swo
*~
.vscode/
.idea/

# Logs and temp
*.log
tmp/
temp/
*.tmp

# Local build/test artifacts
*.tgz
*.tar.gz
